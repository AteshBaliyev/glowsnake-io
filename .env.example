# GlowSnake.io Environment Variables

# Port for the Node.js WebSocket + Next.js server (Default: 3000)
PORT=3000

# Optional: Default Server URL for players (e.g. https://your-server.up.railway.app)
# If left empty, players on the web automatically connect to the current host origin.
NEXT_PUBLIC_SERVER_URL=

# Optional: Firebase Realtime Database URL (if using Firebase serverless sync)
NEXT_PUBLIC_FIREBASE_URL=
